{
  "revision": "defect-policy-2026-11-17-dotnet-and-vue.3",
  "repositories": [
    {
      "repository_id": "KIOSK_TVM",
      "source": "https://dev.azure.com/WLMTS/Genoa%20Kiosk/_git/KIOSK_TVM",
      "target_branch": "MAIN_copy",
      "runner": {
        "kind": "local",
        "env": {
          "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
          "DOTNET_NOLOGO": "1",
          "CI": "true",
          "VISIONIQ_DOTNET_TARGET": "Evoke.Kiosk.RailTVM.API/Evoke.Kiosk.RailTVM.sln",
          "VISIONIQ_NODE_DIR": "Evoke.Kiosk.RailTVM.Ui.Vue3",
          "VISIONIQ_NODE_SCRIPT": "test:unit",
          "VISIONIQ_NODE_CACHE": "C:/visioniq-tools/node-cache"
        },
        "env_allow": [
          "USERPROFILE",
          "APPDATA",
          "LOCALAPPDATA",
          "PROGRAMFILES",
          "PROGRAMFILES(X86)",
          "PROGRAMDATA",
          "HOMEDRIVE",
          "HOMEPATH",
          "COMSPEC",
          "PSMODULEPATH",
          "HTTP_PROXY",
          "HTTPS_PROXY",
          "NO_PROXY"
        ],
        "test_timeout_seconds": 900,
        "suite_timeout_seconds": 2400,
        "benchmark_timeout_seconds": 600
      },
      "recipes": {
        "test_file": [
          "powershell",
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "C:/visioniq-tools/run-tests.ps1",
          "-Mode",
          "test-file",
          "-TestPath",
          "{test_path}",
          "-Report",
          "{junit}"
        ],
        "suite": [
          "powershell",
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "C:/visioniq-tools/run-tests.ps1",
          "-Mode",
          "suite",
          "-Report",
          "{junit}"
        ]
      },
      "toolchain": {
        "dotnet": [
          "dotnet",
          "--version"
        ],
        "node": [
          "node",
          "--version"
        ]
      },
      "dependency_restore": "dotnet test restores NuGet packages; the dispatcher installs Node dependencies once per package-lock.json into VISIONIQ_NODE_CACHE and links them into each run",
      "new_test_paths": [
        "Evoke.Kiosk.RailTVM.API/*.Tests/**",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/src/**/*.spec.ts",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/src/**/*.test.ts",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/tests/**"
      ],
      "test_file_patterns": [
        "Evoke.Kiosk.RailTVM.API/*.Tests/**",
        "Evoke.Kiosk.RailTVM.API/*.Tests.Shared/**",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/src/**/*.spec.ts",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/src/**/*.test.ts",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/tests/**"
      ],
      "writable_paths": [
        "Evoke.Kiosk.RailTVM.API/**",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/src/**",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/tests/**"
      ],
      "restricted_areas": [],
      "lock_files": [
        "global.json",
        "Evoke.Kiosk.RailTVM.Ui.Vue3/package-lock.json"
      ],
      "fixture_paths": [],
      "limits": {
        "max_test_attempts": 2,
        "max_fix_iterations": 3,
        "max_changed_files": 8,
        "max_changed_lines": 400,
        "max_regression_tests": 10,
        "flaky_reruns": 2,
        "red_confirmations": 1,
        "environment_retries": 1
      },
      "draft_pr_on_incomplete": false
    }
  ]
}
