{
  "providers": {
    "azure_devops": {
      "projects": {
        "Genoa Kiosk": {
          "sources": [
            { "type": "title", "pattern": "^\\s*\\[(?<env>dev|sit|uat|prod|live)\\]" },
            { "type": "title", "pattern": "\\b(?<env>CS)\\d{6,}\\b" },
            { "type": "title", "pattern": "\\b(?<env>regression)\\b" }
          ],
          "values": {
            "PROD": ["prod", "live", "CS"],
            "UAT": ["uat"],
            "TEST": ["dev", "sit", "regression"]
          }
        }
      }
    }
  }
}
