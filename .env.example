# VisionIQ v1.11 - shared configuration TEMPLATE (safe to commit)
# Copy to .env; each teammate supplies private values locally. Do NOT commit .env.
# Deployment: LOCAL development first, CLOUD development/testing after validation.
# IMPORTANT: DB_TARGET is a selector for scripts/use-db.ps1, NOT automatic switching.
# Run ./scripts/use-db.ps1 local|cloud after changing DB_TARGET or credentials.
# These are planned configuration contracts; the Python/.NET applications must implement them.

# ========== Execution / application services ==========
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC
APP_HOST=127.0.0.1
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5100
DOTNET_API_BASE_URL=http://localhost:5100
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=8000
PYTHON_API_BASE_URL=http://localhost:8000
# The .NET service may call the Python service at this URL.
PYTHON_SERVICE_URL=http://localhost:8000
# Configure allowed local origins if browser-based development is introduced.
CORS_ALLOWED_ORIGINS=http://localhost:5100,http://localhost:8000

# ========== Database target: local by default ==========
# Supported by existing scripts/use-db.ps1: local | cloud (lowercase)
# .NET and Python must read the effective DB_* variables below.
DB_TARGET=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visioniq
DB_USER=visioniq
DB_PASSWORD=
DB_SSL_MODE=disable
# Local Docker PostgreSQL (existing docker-compose.yml)
DB_LOCAL_PORT=5432
DB_LOCAL_NAME=visioniq
DB_LOCAL_USER=visioniq
DB_LOCAL_PASSWORD=
# FND-03: independent runtime logins; use different passwords for all three.
DB_API_USER=visioniq_api
DB_API_PASSWORD=
DB_INTELLIGENCE_USER=visioniq_intelligence
DB_INTELLIGENCE_PASSWORD=
# Cloud SQL DEVELOPMENT instance through Cloud SQL Auth Proxy, NOT production.
# Instance connection name: project-id:region:instance-id
DB_CLOUD_INSTANCE=
DB_CLOUD_PROXY_PORT=5433
DB_CLOUD_NAME=
DB_CLOUD_USER=
DB_CLOUD_PASSWORD=
# Cloud Run migration job only: provide unique passwords through Secret Manager.
DB_CLOUD_API_PASSWORD=
DB_CLOUD_INTELLIGENCE_PASSWORD=

# ========== Google Cloud developer access ==========
GCP_PROJECT_ID=
GCP_REGION=
VERTEX_LOCATION=
# Leave blank for local gcloud ADC (`gcloud auth application-default login`).
# Do not commit service-account credential files.
GOOGLE_APPLICATION_CREDENTIALS=
# Values are placeholders; confirm model/region/dimension against v1.11.
GEMINI_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# ========== AI provider controls ==========
# Suggested future application contract; enforce provider routing in code.
AI_PRIMARY_PROVIDER=vertex
AI_FALLBACK_PROVIDER=none
# Set only after approved D04 external-data decision / enterprise policy.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# ========== Azure DevOps source of truth ==========
ADO_ORG_URL=
ADO_PROJECTS=
ADO_REPOS=
ADO_DEFAULT_BRANCH=main
ADO_TRIGGER_STATE=
ADO_WORK_ITEM_TYPES=
ADO_PR_PIPELINE_ID=
ADO_READ_PAT=
# Separate least-privileged identity, no merge permission.
ADO_BOT_PAT=
ADO_WEBHOOK_SECRET=

# ========== Jira (only for approved Jira sources) ==========
JIRA_BASE_URL=
JIRA_PROJECT_KEYS=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# ========== Confluence read-only source ==========
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_USER_EMAIL=
CONFLUENCE_API_TOKEN=

# ========== Google Cloud platform resources (configure in FND-04+) ==========
# Empty until resources are actually provisioned. Local smoke tests should
# not require these to be populated.
PUBSUB_TOPIC_ANALYSIS_REQUESTED=
PUBSUB_TOPIC_ANALYSIS_COMPLETED=
PUBSUB_TOPIC_PR_EVENTS=
PUBSUB_DEAD_LETTER_TOPIC=
GCS_BUCKET_SNAPSHOTS=
GCS_BUCKET_RUN_LOGS=

# ========== External repo tooling ==========
# Only populate when specifically required by the approved GitHub MCP setup.
GITHUB_PERSONAL_ACCESS_TOKEN=

# ========== Optional operational controls ==========
# These are proposals until implemented in the services.
ENABLE_BACKGROUND_JOBS=false
ENABLE_EXTERNAL_SYNC=false
ENABLE_CLAUDE=false
REQUEST_TIMEOUT_SECONDS=30
