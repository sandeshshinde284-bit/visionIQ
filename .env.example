# DEFECT INTELLIGENCE — TEAM VISIONIQ
# Shared environment configuration contract | v1 | Local + Cloud Run
#
# SOURCE OF TRUTH: Commit this safe .env.example file to the COMPANY repository.
# LOCAL: Copy to .env (gitignored) and fill private values. Docker Compose uses .env.
# CLOUD: Configure equivalent NON-SECRET keys per Cloud Run service/job and use
#        Google Secret Manager for credentials. Do NOT upload .env to Cloud Run.
#
# Important: KEY=value, no spaces around '=', and no inline comments on values.
# Leave secrets empty in this committed example. Never commit a populated .env.
# Configuration keys marked OPTIONAL/PLANNED may not be consumed by current code.


# ========= 01. Application runtime =========
# Runtime mode is not the GCP environment. Dev GCP may still use production runtime mode.
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC
APP_HOST=127.0.0.1
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5100
# Cloud Run provides PORT at runtime; do not set this manually in Cloud Run.
PORT=
DOTNET_API_BASE_URL=http://localhost:5100
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=8000
PYTHON_API_BASE_URL=http://localhost:8000
# Inside Compose, the API overrides this with http://intelligence:8000.
PYTHON_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5100,http://localhost:8000
REQUEST_TIMEOUT_SECONDS=30

# ========= 02. Database — host-side selection, Docker Compose roles and cloud proxy =========
# DB_TARGET is used by scripts/use-db.ps1; changing it alone does not switch DB_*
DB_TARGET=local
# These are host-machine settings. Compose overrides DB_HOST with 'postgres'.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visioniq
DB_USER=visioniq
# Populated by scripts/use-db.ps1 local from DB_LOCAL_PASSWORD.
DB_PASSWORD=
DB_SSL_MODE=disable
# Dedicated local PostgreSQL instance used by Docker Compose.
DB_LOCAL_PORT=5432
DB_LOCAL_NAME=visioniq
DB_LOCAL_USER=visioniq
# REQUIRED LOCAL SECRETS: supply three distinct strong values in your private .env.
DB_LOCAL_PASSWORD=
DB_API_USER=visioniq_api
DB_API_PASSWORD=
DB_INTELLIGENCE_USER=visioniq_intelligence
DB_INTELLIGENCE_PASSWORD=
# Optional host-side Cloud SQL Auth Proxy target; not used by local Docker Compose.
DB_CLOUD_INSTANCE=
DB_CLOUD_PROXY_PORT=5433
DB_CLOUD_NAME=
DB_CLOUD_USER=
DB_CLOUD_PASSWORD=
# Cloud migration job only, via approved Secret Manager mappings.
DB_CLOUD_API_PASSWORD=
DB_CLOUD_INTELLIGENCE_PASSWORD=
VISIONIQ_CLOUD_RUN_MIGRATIONS=
VISIONIQ_MIGRATION_CONTEXT=

# ========= 03. Google Cloud and Vertex AI =========
# Existing development project; region must match actual resource locations.
GCP_PROJECT_ID=
GCP_REGION=europe-west3
# Vertex embeddings can be hosted in a DIFFERENT region. Verify availability first.
VERTEX_PROJECT=
VERTEX_LOCATION=
# Local ADC: gcloud auth application-default login. NEVER set this in Cloud Run.
GOOGLE_APPLICATION_CREDENTIALS=
# Gemini generative model is not needed to run LEARN embeddings.
GEMINI_MODEL=
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=1
INDEX_BATCH_LIMIT=500

# ========= 04. AI models — generative providers (later BRIEF/DEFECT) =========
# Provider routing is a roadmap contract, not proof it is active in LEARN.
AI_PRIMARY_PROVIDER=vertex
AI_FALLBACK_PROVIDER=none
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
ENABLE_CLAUDE=false

# ========= 05. Azure DevOps source configuration =========
# Scope to approved org, project(s), and test repositories only.
ADO_ORG_URL=
ADO_PROJECTS=
ADO_REPOS=
ADO_DEFAULT_BRANCH=main
ADO_TRIGGER_STATE=
ADO_WORK_ITEM_TYPES=
ADO_PR_PIPELINE_ID=
# Empty ADO_PIPELINE_IDS may mean ALL pipelines; set explicitly before live ingest.
ADO_PIPELINE_IDS=
# Least-privilege PAT; do not put in committed template.
ADO_READ_PAT=
ADO_BOT_PAT=
# LRN-05 webhook auth: ADO_WEBHOOK_SECRET must be >=32 characters when enabled.
ADO_WEBHOOK_USERNAME=
ADO_WEBHOOK_SECRET=

# ========= 06. Jira and Confluence sources =========
JIRA_BASE_URL=
JIRA_PROJECT_KEYS=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_USER_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_DEPLOYMENT=
# Must be an approved private mapping; inaccessible pages stay denied.
CONFLUENCE_IDENTITY_MAP_FILE=

# ========= 07. FND-05 reliable events — Pub/Sub =========
# Shared tenant value identifies this environment, not a real user's identity.
TENANT_ID=visioniq-dev
# Local uses the Pub/Sub emulator; cloud uses the actual GCP project ID.
PUBSUB_PROJECT_ID=visioniq-local
# false is safe by default; Compose enables dispatch in its service overrides.
EVENTS_DISPATCH_ENABLED=false
EVENTS_DISPATCH_INTERVAL_SECONDS=2
EVENT_CONTRACTS_DIR=
# Left unset here; Compose sets PUBSUB_EMULATOR_HOST=pubsub:8085 inside containers.
# NEVER set the emulator host in production Cloud Run.
PUBSUB_EMULATOR_HOST=
# Emulator-only target overrides, normally not needed.
EVENTS_PUSH_BASE_URL_API=
EVENTS_PUSH_BASE_URL_INTELLIGENCE=
# Topic names are defined by contracts/events/topology.json (not PUBSUB_TOPIC_*).

# ========= 08. BRF-01 ticket pickup (optional; disabled until configured) =========
# Container path for Compose if enabled: /app/config/pickup-policy.local.json
PICKUP_POLICY_FILE=
# Required, >=24 chars, only when PICKUP_POLICY_FILE is configured.
PICKUP_WEBHOOK_SECRET=
PICKUP_WORKER_INTERVAL_SECONDS=2
PICKUP_SWEEP_INTERVAL_MINUTES=15
PICKUP_SWEEP_LOOKBACK_HOURS=24

# ========= 09. Ingestion / currentness / canonical evidence =========
# Blank means full history on first run. A saved checkpoint can override --since.
INGESTION_SINCE=
INGESTION_OUTPUT_DIR=artifacts/ingestion
# jsonl = local test files; canonical = actual PostgreSQL + GCS archive.
INGESTION_OUTPUT_MODE=jsonl
# file for isolated connector trials; postgres for canonical E2E after approval.
CHECKPOINT_STORE=file
# Cloud Storage bucket for canonical archived evidence. Never wipe it during tests.
GCS_EVIDENCE_BUCKET=
GCS_BUCKET_SNAPSHOTS=
GCS_BUCKET_RUN_LOGS=
INGESTION_REQUEST_TIMEOUT_SECONDS=100

# ========= 10. Graph auth / rules / lessons =========
# Graph API is disabled if authorization settings are unset.
VISIONIQ_AUTH_TENANT_ID=
VISIONIQ_AUTH_AUDIENCES=
VISIONIQ_AUTH_SCOPE=Graph.Read
VISIONIQ_AUTH_ALLOWED_CALLERS=
ADO_ENVIRONMENT_RULES_FILE=
ADO_ENVIRONMENT_RULES=
LESSON_DEFECT_TYPES=Bug

# ========= 11. Logging and additional optional controls =========
LOG_LEVEL=Information
LOG_FORMAT=text
# Optional pseudonymization key; supply >=32 random characters if enabled.
LOG_PSEUDONYM_KEY=
# Reserved / optional; not a guarantee functionality is currently active.
ENABLE_BACKGROUND_JOBS=false
ENABLE_EXTERNAL_SYNC=false
GITHUB_PERSONAL_ACCESS_TOKEN=


INGESTION_EVIDENCE_CONCURRENCY=8
