# VisionIQ — unified team environment contract | 2026-11-12
# Share/commit THIS .env.example in the approved COMPANY repository.
# Each developer: copy to .env (gitignored), supply OWN secrets, run scripts/use-db.ps1 local.
# Do not commit .env, real passwords, PATs, API tokens, or cloud credentials.
# Cloud Run: same supported key names per service; runtime-specific values and Secret Manager.
# Empty SECRET values below are intentional. Do NOT deploy these defaults as-is.
# No duplicate keys, no inline comments after KEY=value, no spaces around '='.
# Safe defaults do not activate ADO writes, pickup, BRIEF or DEFECT execution.

# ===== 01. Application runtime =====
APP_ENV=development
APP_LOG_LEVEL=INFO
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5100
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=8000
PYTHON_SERVICE_URL=http://localhost:8000
REQUEST_TIMEOUT_SECONDS=30

# ===== 02. Local database and host-side database selector =====
# DB_TARGET is used by scripts/use-db.ps1; do not assume editing it switches runtime DB.
# Host-side DB_* are rewritten by scripts/use-db.ps1 local|cloud.
# Docker Compose explicitly connects to postgres using DB_LOCAL_* and runtime-role credentials.
DB_TARGET=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visioniq
DB_USER=visioniq
DB_PASSWORD=
DB_SSL_MODE=disable
DB_LOCAL_PORT=5432
DB_LOCAL_NAME=visioniq
DB_LOCAL_USER=visioniq
# REQUIRED: assign distinct, strong private passwords in each developer's .env.
DB_LOCAL_PASSWORD=
DB_API_USER=visioniq_api
DB_API_PASSWORD=
DB_INTELLIGENCE_USER=visioniq_intelligence
DB_INTELLIGENCE_PASSWORD=

# ===== 03. Cloud SQL host proxy / controlled migration job (NOT local Compose) =====
# Leave blank for LOCAL development; cloud migration controls are approval-gated.
DB_CLOUD_INSTANCE=
DB_CLOUD_PROXY_PORT=5433
DB_CLOUD_NAME=
DB_CLOUD_USER=
DB_CLOUD_PASSWORD=
DB_CLOUD_API_PASSWORD=
DB_CLOUD_INTELLIGENCE_PASSWORD=
VISIONIQ_CLOUD_RUN_MIGRATIONS=
VISIONIQ_MIGRATION_CONTEXT=

# ===== 04. GCP + real Vertex AI embeddings =====
# Cloud Run / Cloud SQL deployment region is europe-west3 (Frankfurt).
# Vertex model serving may be in a DIFFERENT supported region, per model availability/policy.
GCP_PROJECT_ID=gbr-mts-wgh-hkt-dev
GCP_REGION=europe-west3
VERTEX_LOCATION=europe-west3
# For real LEARN embeddings use vertex; test is deterministic hashing (offline fixtures only).
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=1
EMBEDDING_REQUEST_TIMEOUT=60
EMBEDDING_MAX_RETRIES=5
INDEX_BATCH_LIMIT=500

# ===== 05. Gemini / optional Claude for BRIEF and DEFECT =====
# BRIEF disabled by default; do NOT enable until model, data-policy and budget reviewed.
BRIEF_PIPELINE_ENABLED=false
LLM_MODE=live
GEMINI_MODEL=gemini-2.5-flash
CLAUDE_ROUTE=off
CLAUDE_MODEL=
LLM_CLAUDE_MAX_CLASSIFICATION=
ANTHROPIC_API_KEY=
BRIEF_PUBLISH_MODE=off
HOTSPOT_SWEEP_INTERVAL_HOURS=0

# ===== 06. DEFECT deep analysis + draft PR delivery =====
DEFECT_PIPELINE_ENABLED=false
DEFECT_POLICY_FILE=
# Read-only Azure DevOps token (scope Code: Read) used ONLY to clone a private repository for a fix
# run; sent only over HTTPS to DEFECT_REPO_TOKEN_HOSTS. Not the comment or pull-request token.
DEFECT_REPO_READ_PAT=
DEFECT_REPO_TOKEN_HOSTS=dev.azure.com
# Check a clone without running a fix: python -m app.defect.clone_check --repository <id> --base-sha <sha>
# A folder for a local mirror of each cloned repository: the first fix run downloads it, later runs
# only fetch new commits (every run still works on its own fresh copy). Empty: clone every time.
DEFECT_REPO_CACHE_DIR=
# How much of the repository a fix run downloads.
#   full    clone it with its whole history (default)
#   commit  download only the commit the run is pinned to: a run uses nothing else. If the server
#           does not hand out a single commit, the repository is cloned as with "full".
DEFECT_REPO_FETCH=full
# Model selection by complexity for a fix run's two code tasks (reproduction test and fix).
#   fixed          the routing table decides, as before (default)
#   by_complexity  each run is rated simple / standard / complex from its brief (risk band, files
#                  in scope, restricted areas) and uses that tier's model; a failed attempt moves
#                  one tier up
# A tier is "<provider>" or "<provider>:<model>", provider gemini or claude, for example
# claude:claude-haiku-5-5. An empty tier follows the routing table. A tier's provider must itself
# be enabled and allowed for the data classification (CLAUDE_ROUTE, LLM_CLAUDE_MAX_CLASSIFICATION).
DEFECT_MODEL_SELECTION=fixed
DEFECT_MODEL_SIMPLE=
DEFECT_MODEL_STANDARD=
DEFECT_MODEL_COMPLEX=
DEFECT_SIMPLE_MAX_FILES=2
DEFECT_COMPLEX_MIN_FILES=6
DEFECT_OFFLINE_SCRIPT=
FIX_PR_MODE=record
FIX_AUTO_START=false

# ===== 07. Azure DevOps approved test source =====
ADO_ORG_URL=https://dev.azure.com/WLMTS
ADO_PROJECTS=Genoa Kiosk
ADO_REPOS=TEST_DF_VISIONIQ_POC
ADO_DEFAULT_BRANCH=main
# Blank may mean all pipelines; set explicit IDs before approved broad ingestion.
ADO_PIPELINE_IDS=
# Each developer supplies own least-privileged credentials. Distinct write identities.
ADO_READ_PAT=#'<ADO-token>'
ADO_BOT_PAT=
ADO_COMMENT_PAT=
ADO_PR_PAT=

# Generate ADO_WEBHOOK_SECRET from below command
# $bytes = New-Object byte[] 32
# [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
# [Convert]::ToBase64String($bytes)
ADO_WEBHOOK_USERNAME=visioniq-webhook
ADO_WEBHOOK_SECRET=#'<ADO WEB-token>'=

# ===== 08. Confluence read-only source =====
CONFLUENCE_BASE_URL=https://worldline.atlassian.net/wiki
CONFLUENCE_SPACE_KEYS=ERK
CONFLUENCE_USER_EMAIL=sandesh.shinde@magellangroup.eu
CONFLUENCE_API_TOKEN=#'<Conluence-token>'
CONFLUENCE_DEPLOYMENT=

# ===== 09. Local Pub/Sub emulator / cloud eventing =====
TENANT_ID=visioniq-dev
PUBSUB_PROJECT_ID=visioniq-local
# Compose explicitly overrides dispatch to true, and sets the emulator URL in containers.
EVENTS_DISPATCH_ENABLED=false
EVENTS_DISPATCH_INTERVAL_SECONDS=2
EVENT_CONTRACTS_DIR=
PUBSUB_EMULATOR_HOST=
EVENTS_PUSH_BASE_URL_API=
EVENTS_PUSH_BASE_URL_INTELLIGENCE=

# ===== 10. BRF-01 pickup — OFF by default =====
# Never point to pickup-policy.example.json for real tickets. Use an approved scoped policy.
PICKUP_POLICY_FILE=
PICKUP_WEBHOOK_SECRET=
PICKUP_ALLOWED_WORK_ITEM_IDS=
PICKUP_WORKER_INTERVAL_SECONDS=2
PICKUP_SWEEP_INTERVAL_MINUTES=0
PICKUP_SWEEP_LOOKBACK_HOURS=24

# ===== 11. Ingestion, evidence archive, checkpoints =====
# Team-approved history start: review scope before expanding source ingestion.
INGESTION_SINCE=2026-01-01
INGESTION_OUTPUT_DIR=artifacts/ingestion/lrn01-manual
# jsonl = local test output; canonical = PostgreSQL + approved GCS evidence storage.
INGESTION_OUTPUT_MODE=jsonl
CHECKPOINT_STORE=file
GCS_EVIDENCE_BUCKET=visioniq-source-evidence-dev
INGESTION_REQUEST_TIMEOUT_SECONDS=100
INGESTION_EVIDENCE_CONCURRENCY=8

# ===== 12. Graph auth / ADO environment classification / LEARN lessons =====
VISIONIQ_AUTH_TENANT_ID=
VISIONIQ_AUTH_AUDIENCES=
VISIONIQ_AUTH_SCOPE=Graph.Read
VISIONIQ_AUTH_ALLOWED_CALLERS=
ADO_ENVIRONMENT_RULES_FILE=
ADO_ENVIRONMENT_RULES=
LESSON_DEFECT_TYPES=Bug

# ===== 13. Logging / test runner =====
LOG_LEVEL=Information
LOG_FORMAT=text
LOG_PSEUDONYM_KEY=
LEARN_E2E_COMMAND_TIMEOUT_SECONDS=1800

# ===== 14. COMMENTED / RESERVED CONFIGURATION KEYS =====
# Retained from both original team .env files for future use.
# These lines are COMMENTS and do not configure any service.
# Uncomment ONLY after confirming a real code consumer, approved defaults,
# tests, and the intended environment. Do NOT copy real credentials here.
# IMPORTANT: Do not add a second active definition of any key above.

