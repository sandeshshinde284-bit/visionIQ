# VisionIQ — combined company .env.example (safe to commit)
# Consolidates updated company dev BRIEF/PICKUP/DEFECT configuration with LEARN/Infra configuration.
# TEMPLATE ONLY: copy to local .env and set PRIVATE values; do not commit real secrets.
# In Cloud Run, set non-secret env vars per service and use Secret Manager for secrets.
# Verify actual BRIEF/DEFECT configuration keys against company source before merging.
# No duplicate keys. No embedded credentials. Defaults are conservative.
# Safe template defaults are NOT substitutes for validated per-service Cloud Run configuration.
# A historical value of PICKUP_WEBHOOK_SECRET was committed to dev; rotate it if ever active.

# ========= 01. Application runtime =========
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_TIMEZONE=UTC
APP_HOST=127.0.0.1
DOTNET_ENVIRONMENT=Development
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5100
PORT=
DOTNET_API_BASE_URL=http://localhost:5100
PYTHON_API_HOST=127.0.0.1
PYTHON_API_PORT=8000
PYTHON_API_BASE_URL=http://localhost:8000
PYTHON_SERVICE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5100,http://localhost:8000
REQUEST_TIMEOUT_SECONDS=30

# ========= 02. Database — local/private Cloud SQL configuration =========
# DB_TARGET is a selector for scripts/use-db.ps1, not an automatic runtime switch.
DB_TARGET=local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=visioniq
DB_USER=visioniq
DB_PASSWORD=
DB_SSL_MODE=disable
DB_LOCAL_PORT=5432
DB_LOCAL_NAME=visioniq
DB_LOCAL_USER=visioniq
DB_LOCAL_PASSWORD=
DB_API_USER=visioniq_api
DB_API_PASSWORD=
DB_INTELLIGENCE_USER=visioniq_intelligence
DB_INTELLIGENCE_PASSWORD=
DB_CLOUD_INSTANCE=
DB_CLOUD_PROXY_PORT=5433
DB_CLOUD_NAME=
DB_CLOUD_USER=
DB_CLOUD_PASSWORD=
DB_CLOUD_API_PASSWORD=
DB_CLOUD_INTELLIGENCE_PASSWORD=
VISIONIQ_CLOUD_RUN_MIGRATIONS=
VISIONIQ_MIGRATION_CONTEXT=

# ========= 03. Google Cloud and Vertex AI =========
GCP_PROJECT_ID=
GCP_REGION=europe-west3
VERTEX_PROJECT=
VERTEX_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=
# Real LEARN/Cloud embeddings: vertex. For isolated local tests, override in private .env.
EMBEDDING_PROVIDER=vertex
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=1
INDEX_BATCH_LIMIT=500

# ========= 04. AI providers / BRIEF =========
AI_PRIMARY_PROVIDER=vertex
AI_FALLBACK_PROVIDER=none
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
ENABLE_CLAUDE=false
# BRIEF settings from company dev: enable only in approved runtime with required inputs.
BRIEF_PIPELINE_ENABLED=false
LLM_MODE=offline
BRIEF_PUBLISH_MODE=record

# ========= 05. Azure DevOps =========
ADO_ORG_URL=
ADO_PROJECTS=
ADO_REPOS=
ADO_DEFAULT_BRANCH=main
ADO_TRIGGER_STATE=
ADO_WORK_ITEM_TYPES=
ADO_PR_PIPELINE_ID=
# Blank ADO_PIPELINE_IDS may ingest all approved pipelines.
ADO_PIPELINE_IDS=
ADO_READ_PAT=
# Separate PR credential only if the DEFECT workflow requires it.
# Use a least-privileged secret with the minimum scopes approved by the company.
ADO_BOT_PAT=
ADO_PR_PAT=
ADO_WEBHOOK_USERNAME=
ADO_WEBHOOK_SECRET=

# ========= 06. Jira and Confluence =========
JIRA_BASE_URL=
JIRA_PROJECT_KEYS=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_SPACE_KEYS=
CONFLUENCE_USER_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_DEPLOYMENT=
CONFLUENCE_IDENTITY_MAP_FILE=

# ========= 07. Reliable events / Pub/Sub =========
TENANT_ID=visioniq-dev
# Local emulator project only; override for actual GCP.
PUBSUB_PROJECT_ID=visioniq-local
EVENTS_DISPATCH_ENABLED=false
EVENTS_DISPATCH_INTERVAL_SECONDS=2
EVENT_CONTRACTS_DIR=
# Unset emulator in Cloud Run.
PUBSUB_EMULATOR_HOST=
EVENTS_PUSH_BASE_URL_API=
EVENTS_PUSH_BASE_URL_INTELLIGENCE=
# Legacy/planned topic environment variables from dev. Verify code usage;
# current topology is defined in contracts/events/topology.json.
PUBSUB_TOPIC_ANALYSIS_REQUESTED=
PUBSUB_TOPIC_ANALYSIS_COMPLETED=
PUBSUB_TOPIC_PR_EVENTS=
PUBSUB_DEAD_LETTER_TOPIC=

# ========= 08. BRF-01 ticket pickup =========
# Safe template: disabled unless an approved policy is configured privately.
# In Compose, a configured policy may be mounted under /app/config/.
PICKUP_POLICY_FILE=
PICKUP_WEBHOOK_SECRET=
PICKUP_WORKER_INTERVAL_SECONDS=2
# 0 was the company dev value; do not enable automatic sweeping without review.
PICKUP_SWEEP_INTERVAL_MINUTES=0
PICKUP_SWEEP_LOOKBACK_HOURS=24

# ========= 09. DEFECT workflow (introduced on updated company dev) =========
# Disabled for safe local startup. Only enable after checking DEFECT source code,
# authorization, review gates and the intended PR creation behavior.
DEFECT_PIPELINE_ENABLED=false
DEFECT_POLICY_FILE=
DEFECT_OFFLINE_SCRIPT=
# "record" must be verified against DEFECT runtime; do not silently enable PR writes.
FIX_PR_MODE=record
FIX_AUTO_START=false

# ========= 10. Ingestion and evidence archive =========
INGESTION_SINCE=
INGESTION_OUTPUT_DIR=artifacts/ingestion
# Safe default; explicitly use 'canonical' with approved DB/GCS for real E2E.
INGESTION_OUTPUT_MODE=jsonl
CHECKPOINT_STORE=file
GCS_EVIDENCE_BUCKET=
GCS_BUCKET_SNAPSHOTS=
GCS_BUCKET_RUN_LOGS=
INGESTION_REQUEST_TIMEOUT_SECONDS=100
INGESTION_EVIDENCE_CONCURRENCY=8

# ========= 11. Code relationships / lesson qualification =========
VISIONIQ_AUTH_TENANT_ID=
VISIONIQ_AUTH_AUDIENCES=
VISIONIQ_AUTH_SCOPE=Graph.Read
VISIONIQ_AUTH_ALLOWED_CALLERS=
ADO_ENVIRONMENT_RULES_FILE=
ADO_ENVIRONMENT_RULES=
LESSON_DEFECT_TYPES=Bug

# ========= 12. Logs / optional controls =========
LOG_LEVEL=Information
LOG_FORMAT=text
LOG_PSEUDONYM_KEY=
ENABLE_BACKGROUND_JOBS=false
ENABLE_EXTERNAL_SYNC=false
GITHUB_PERSONAL_ACCESS_TOKEN=
