#AI_PRIMARY_PROVIDER=vertex
#AI_FALLBACK_PROVIDER=none
#ENABLE_CLAUDE=false
#ENABLE_BACKGROUND_JOBS=false
#ENABLE_EXTERNAL_SYNC=false

# --- ADO proposals (no confirmed runtime consumers) ---
#ADO_TRIGGER_STATE=
#ADO_WORK_ITEM_TYPES=
#ADO_PR_PIPELINE_ID=

# --- Pub/Sub topic overrides (topology currently comes from contracts/events/topology.json) ---
#PUBSUB_TOPIC_ANALYSIS_REQUESTED=
#PUBSUB_TOPIC_ANALYSIS_COMPLETED=
#PUBSUB_TOPIC_PR_EVENTS=
#PUBSUB_DEAD_LETTER_TOPIC=

# --- Planned additional Cloud Storage buckets (not evidence archive bucket) ---
#GCS_BUCKET_SNAPSHOTS=
#GCS_BUCKET_RUN_LOGS=

# --- Jira integration placeholders (not implemented in the inspected runtime) ---
#JIRA_BASE_URL=
#JIRA_PROJECT_KEYS=
#JIRA_USER_EMAIL=
#JIRA_API_TOKEN=

# --- Future Confluence identity mapping ---
#CONFLUENCE_IDENTITY_MAP_FILE=

# --- Optional developer / deployment overrides, not global team defaults ---
# Local explicit credentials file only if ADC is not suitable; never use a key file in Cloud Run.
