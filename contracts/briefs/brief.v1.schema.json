{
  "$defs": {
    "Advice": {
      "additionalProperties": false,
      "description": "7.4.1: one atomic, individually rateable piece of advice.",
      "properties": {
        "advice_id": {
          "pattern": "^ADV-[0-9]{3}$",
          "title": "Advice Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "evidence_state": {
          "default": "UNVERIFIED",
          "enum": [
            "UNVERIFIED",
            "DISPUTED"
          ],
          "title": "Evidence State",
          "type": "string"
        },
        "kind": {
          "enum": [
            "RISK",
            "DO",
            "DONT",
            "APPROACH"
          ],
          "title": "Kind",
          "type": "string"
        },
        "statement": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "support": {
          "items": {
            "$ref": "#/$defs/Support"
          },
          "minItems": 1,
          "title": "Support",
          "type": "array"
        }
      },
      "required": [
        "advice_id",
        "kind",
        "statement",
        "evidence_ids",
        "support"
      ],
      "title": "Advice",
      "type": "object"
    },
    "DisagreementNote": {
      "additionalProperties": false,
      "properties": {
        "advice_id": {
          "title": "Advice Id",
          "type": "string"
        },
        "drafted_by": {
          "title": "Drafted By",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "reviewed_by": {
          "title": "Reviewed By",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "unsupported",
            "conflicting"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "advice_id",
        "drafted_by",
        "reviewed_by",
        "verdict",
        "reason"
      ],
      "title": "DisagreementNote",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "One source the brief cites. ``url`` opens it in ADO, Git or Confluence.",
      "properties": {
        "id": {
          "pattern": "^E[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "item_key": {
          "title": "Item Key",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "relevance": {
          "enum": [
            "strong",
            "related"
          ],
          "title": "Relevance",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revision"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "id",
        "item_key",
        "kind",
        "title",
        "url",
        "revision",
        "snippet",
        "relevance"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Generation": {
      "additionalProperties": false,
      "description": "Which model wrote the advice, with which prompt and routing (10.9 rule 4).",
      "properties": {
        "calls": {
          "default": 0,
          "title": "Calls",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Id"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "prompt_template_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Template Version"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "routing_revision": {
          "title": "Routing Revision",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model_id",
        "prompt_template_version",
        "routing_revision"
      ],
      "title": "Generation",
      "type": "object"
    },
    "InjectionFlag": {
      "additionalProperties": false,
      "description": "Instruction-like text found in a source. It was treated as data and not followed.",
      "properties": {
        "pattern": {
          "title": "Pattern",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "pattern"
      ],
      "title": "InjectionFlag",
      "type": "object"
    },
    "Risk": {
      "additionalProperties": false,
      "description": "S10-13: an ordinal band with its factors. Never a probability.",
      "properties": {
        "band": {
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "INSUFFICIENT_DATA"
          ],
          "title": "Band",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/RiskFactor"
          },
          "title": "Factors",
          "type": "array"
        }
      },
      "required": [
        "band",
        "explanation",
        "factors"
      ],
      "title": "Risk",
      "type": "object"
    },
    "RiskFactor": {
      "additionalProperties": false,
      "description": "S10-03: one observed count behind the band. ``missing`` means the data was not there.",
      "properties": {
        "code": {
          "pattern": "^[a-z_]{1,40}$",
          "title": "Code",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "missing": {
          "default": false,
          "title": "Missing",
          "type": "boolean"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "window_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Days"
        }
      },
      "required": [
        "code",
        "label",
        "value"
      ],
      "title": "RiskFactor",
      "type": "object"
    },
    "ScopeItem": {
      "additionalProperties": false,
      "description": "S10-02: a file or area this ticket probably touches, and why we think so.",
      "properties": {
        "basis": {
          "enum": [
            "named_in_ticket",
            "stack_trace_symbol",
            "changed_by_past_fix"
          ],
          "title": "Basis",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "exact",
            "inferred"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "basis",
        "confidence"
      ],
      "title": "ScopeItem",
      "type": "object"
    },
    "Support": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "quote"
      ],
      "title": "Support",
      "type": "object"
    },
    "TicketRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "system": {
          "const": "ado",
          "default": "ado",
          "title": "System",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "project",
        "id",
        "revision"
      ],
      "title": "TicketRef",
      "type": "object"
    },
    "Timings": {
      "additionalProperties": false,
      "description": "S10-11: stage times inside Intelligence, in milliseconds.",
      "properties": {
        "generation_ms": {
          "minimum": 0,
          "title": "Generation Ms",
          "type": "integer"
        },
        "retrieval_ms": {
          "minimum": 0,
          "title": "Retrieval Ms",
          "type": "integer"
        },
        "total_ms": {
          "minimum": 0,
          "title": "Total Ms",
          "type": "integer"
        }
      },
      "required": [
        "retrieval_ms",
        "generation_ms",
        "total_ms"
      ],
      "title": "Timings",
      "type": "object"
    }
  },
  "$id": "https://visioniq.internal/schemas/briefs/brief.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "advice": {
      "items": {
        "$ref": "#/$defs/Advice"
      },
      "title": "Advice",
      "type": "array"
    },
    "brief_id": {
      "format": "uuid",
      "title": "Brief Id",
      "type": "string"
    },
    "disagreements": {
      "items": {
        "$ref": "#/$defs/DisagreementNote"
      },
      "title": "Disagreements",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "generation": {
      "$ref": "#/$defs/Generation"
    },
    "injection_flags": {
      "items": {
        "$ref": "#/$defs/InjectionFlag"
      },
      "title": "Injection Flags",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "predicted_scope": {
      "items": {
        "$ref": "#/$defs/ScopeItem"
      },
      "title": "Predicted Scope",
      "type": "array"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "risk": {
      "$ref": "#/$defs/Risk"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    },
    "state": {
      "enum": [
        "PUBLISHED",
        "PARTIAL",
        "BLOCKED"
      ],
      "title": "State",
      "type": "string"
    },
    "ticket": {
      "$ref": "#/$defs/TicketRef"
    },
    "timings": {
      "$ref": "#/$defs/Timings"
    }
  },
  "required": [
    "brief_id",
    "run_id",
    "ticket",
    "state",
    "risk",
    "generation",
    "timings"
  ],
  "title": "Ticket brief v1 (S10-04)",
  "type": "object"
}
