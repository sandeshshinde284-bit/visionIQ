{
  "$defs": {
    "Attempt": {
      "additionalProperties": false,
      "description": "One iteration of the budget, kept whether it worked or not.",
      "properties": {
        "candidate_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Sha"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "iteration": {
          "minimum": 1,
          "title": "Iteration",
          "type": "integer"
        },
        "result": {
          "pattern": "^[a-z_]{1,60}$",
          "title": "Result",
          "type": "string"
        },
        "stage": {
          "enum": [
            "reproduction_test",
            "patch"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "iteration",
        "stage",
        "result"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "CheckEvidence": {
      "additionalProperties": false,
      "description": "One check: every execution made for it under the rerun policy, and the result.\n\n``first_outcome`` is what the first execution said. Reruns never replace it: a test that\nfailed once and then passed is FLAKY, not PASS.",
      "properties": {
        "execution_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Execution Ids",
          "type": "array"
        },
        "failure_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Signature"
        },
        "first_outcome": {
          "enum": [
            "PASS",
            "FAIL_TARGET_SIGNATURE",
            "FAIL_DIFFERENT_SIGNATURE",
            "FLAKY",
            "ENVIRONMENT_ERROR",
            "TIMEOUT",
            "NOT_RUN",
            "UNAVAILABLE",
            "INCONCLUSIVE"
          ],
          "title": "First Outcome",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL_TARGET_SIGNATURE",
            "FAIL_DIFFERENT_SIGNATURE",
            "FLAKY",
            "ENVIRONMENT_ERROR",
            "TIMEOUT",
            "NOT_RUN",
            "UNAVAILABLE",
            "INCONCLUSIVE"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "test_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Test Id"
        },
        "test_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Test Path"
        }
      },
      "required": [
        "test_path",
        "test_id",
        "outcome",
        "first_outcome",
        "execution_ids"
      ],
      "title": "CheckEvidence",
      "type": "object"
    },
    "Execution": {
      "additionalProperties": false,
      "description": "8.6.1: one runner invocation with what it ran, on which commit, and where its log is.",
      "properties": {
        "code": {
          "enum": [
            "baseline",
            "candidate"
          ],
          "title": "Code",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "commit_sha": {
          "title": "Commit Sha",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "execution_id": {
          "pattern": "^X[0-9]{1,4}$",
          "title": "Execution Id",
          "type": "string"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exit Code"
        },
        "failure_signature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Signature"
        },
        "log_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Log Sha256",
          "type": "string"
        },
        "log_uri": {
          "title": "Log Uri",
          "type": "string"
        },
        "manifest_id": {
          "title": "Manifest Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "PASS",
            "FAIL_TARGET_SIGNATURE",
            "FAIL_DIFFERENT_SIGNATURE",
            "FLAKY",
            "ENVIRONMENT_ERROR",
            "TIMEOUT",
            "NOT_RUN",
            "UNAVAILABLE",
            "INCONCLUSIVE"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "reproduction",
            "candidate",
            "regression",
            "suite",
            "benchmark"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "test_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Test Id"
        },
        "timed_out": {
          "default": false,
          "title": "Timed Out",
          "type": "boolean"
        }
      },
      "required": [
        "execution_id",
        "manifest_id",
        "purpose",
        "code",
        "commit_sha",
        "command",
        "started_at",
        "duration_ms",
        "exit_code",
        "outcome",
        "log_uri",
        "log_sha256"
      ],
      "title": "Execution",
      "type": "object"
    },
    "ExecutionManifest": {
      "additionalProperties": false,
      "description": "8.6.3: written before generated code runs; every execution links to one manifest.",
      "properties": {
        "base_sha": {
          "title": "Base Sha",
          "type": "string"
        },
        "candidate_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Sha"
        },
        "commands": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Commands",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dependency_restore": {
          "default": "none",
          "title": "Dependency Restore",
          "type": "string"
        },
        "environment_names": {
          "items": {
            "type": "string"
          },
          "title": "Environment Names",
          "type": "array"
        },
        "expected_test_ids": {
          "items": {
            "type": "string"
          },
          "title": "Expected Test Ids",
          "type": "array"
        },
        "fixture_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Fixture Hashes",
          "type": "object"
        },
        "lock_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Lock Hashes",
          "type": "object"
        },
        "manifest_id": {
          "pattern": "^M[0-9]{1,3}$",
          "title": "Manifest Id",
          "type": "string"
        },
        "policy_revision": {
          "title": "Policy Revision",
          "type": "string"
        },
        "repository_id": {
          "title": "Repository Id",
          "type": "string"
        },
        "runner": {
          "$ref": "#/$defs/RunnerInfo"
        },
        "sha256": {
          "default": "",
          "pattern": "^([0-9a-f]{64})?$",
          "title": "Sha256",
          "type": "string"
        },
        "ticket_id": {
          "title": "Ticket Id",
          "type": "string"
        },
        "timeouts_seconds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timeouts Seconds",
          "type": "object"
        },
        "toolchain": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Toolchain",
          "type": "object"
        }
      },
      "required": [
        "manifest_id",
        "ticket_id",
        "repository_id",
        "base_sha",
        "runner",
        "policy_revision",
        "created_at"
      ],
      "title": "ExecutionManifest",
      "type": "object"
    },
    "ExpectedFailure": {
      "additionalProperties": false,
      "description": "The failure the test's author predicted for the baseline, stated before it ran.",
      "properties": {
        "exception": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exception"
        },
        "message_contains": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Message Contains",
          "type": "array"
        }
      },
      "required": [
        "message_contains"
      ],
      "title": "ExpectedFailure",
      "type": "object"
    },
    "FileChange": {
      "additionalProperties": false,
      "description": "One changed file with its complete new content, so the change can be recreated.",
      "properties": {
        "added_lines": {
          "minimum": 0,
          "title": "Added Lines",
          "type": "integer"
        },
        "change": {
          "enum": [
            "added",
            "modified"
          ],
          "title": "Change",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "removed_lines": {
          "minimum": 0,
          "title": "Removed Lines",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "change",
        "sha256",
        "added_lines",
        "removed_lines",
        "content"
      ],
      "title": "FileChange",
      "type": "object"
    },
    "Gate": {
      "additionalProperties": false,
      "description": "One piece of evidence, kept separate from the others (8.6.1).",
      "properties": {
        "commit_sha": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
