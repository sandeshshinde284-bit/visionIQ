        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "execution_ids": {
          "items": {
            "type": "string"
          },
          "title": "Execution Ids",
          "type": "array"
        },
        "name": {
          "enum": [
            "reproduction",
            "candidate_test",
            "historical_regression",
            "touched_suite",
            "performance",
            "patch_policy",
            "native_ci",
            "human_review"
          ],
          "title": "Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "INCONCLUSIVE",
            "UNAVAILABLE",
            "REVIEW_REQUIRED",
            "NOT_APPLICABLE"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "required",
        "status",
        "detail"
      ],
      "title": "Gate",
      "type": "object"
    },
    "GateSummary": {
      "additionalProperties": false,
